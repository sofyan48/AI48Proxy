# Copy to .env. Never put HOME_JWT or management credentials here.
# Run each additional worker with a different Compose project name and token file.
COMPOSE_PROJECT_NAME=ai48proxy-canary
AI48PROXY_IMAGE=ai48proxy:local
RUST_IMAGE=rust:bookworm

# AI48Home/install.sh explicitly creates cliproxy-network (not a project prefix).
# Verify the deployed network and Home's advertised token endpoint before starting.
AI48PROXY_HOME_NETWORK=cliproxy-network
# Prefer an absolute path OUTSIDE the checkout. This file contains only the JWT.
AI48PROXY_HOME_JWT_FILE=./secrets/home-jwt

# Host 8317 is already occupied by the installer's nginx. Keep the canary private.
AI48PROXY_BIND_IP=127.0.0.1
AI48PROXY_PUBLISHED_PORT=18317
# Mapping/healthcheck only: these do NOT configure the actual Home-supplied listener.
AI48PROXY_LISTEN_PORT=8317
AI48PROXY_HEALTHCHECK_URL=http://127.0.0.1:8317/healthz
AI48PROXY_STOP_GRACE_PERIOD=120s
RUST_LOG=ai48proxy=info

# Optional docker-compose.home.yml ONLY, after stopping that original CPA worker.
# AI48PROXY_REPLACE_ALIAS=cliproxy-1
